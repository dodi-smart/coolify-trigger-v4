# Trigger.dev v4 — Coolify Docker Compose resource
#
# Deploy from the Coolify UI. On the first deploy Coolify generates every
# SERVICE_* magic variable below and stores it per-resource — never
# hand-maintain SERVICE_* values yourself. This file only documents the
# variables you edit in the Coolify env UI and supports a local
# `docker compose config` syntax check (see bottom of file).

# -----------------------------------------------------------------------------
# Required after first deploy (the two-step)
# -----------------------------------------------------------------------------
# MUST stay EMPTY on the first deploy. After it succeeds, copy the Coolify
# resource UUID network name and set it here, then redeploy — otherwise
# runs sit stuck in `dequeued` forever (trigger.dev#2584).
DOCKER_RUNNER_NETWORKS=

# -----------------------------------------------------------------------------
# Email (Resend is the default transport)
# -----------------------------------------------------------------------------
EMAIL_TRANSPORT=resend
# Alternatives: smtp, aws-ses

# Without RESEND_API_KEY, magic-link login URLs are only printed to the
# trigger container logs — nobody receives an email.
RESEND_API_KEY=
# Must be a Resend-verified sending domain.
FROM_EMAIL=Trigger.dev <trigger@yourdomain.com>
REPLY_TO_EMAIL=

# SMTP alternative (set EMAIL_TRANSPORT=smtp to use these instead):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# false = STARTTLS, not plaintext
# SMTP_USER=
# SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Access control
# -----------------------------------------------------------------------------
# Regex of allowed login emails — strongly recommended on a public instance.
WHITELISTED_EMAILS=
# Regex of emails granted admin on signup.
ADMIN_EMAILS=

# Optional GitHub OAuth login.
# Callback URL: https://<app-domain>/auth/github/callback
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Versions / images
# -----------------------------------------------------------------------------
TRIGGER_IMAGE_TAG=v4.5.12
# v4.5.0 is the last tag that runs v3 SDK tasks. `latest` tracks the newest release.
POSTGRES_IMAGE_TAG=14
REDIS_IMAGE_TAG=7
ELECTRIC_IMAGE_TAG=1.2.4
CLICKHOUSE_IMAGE_TAG=26.2
# ClickHouse >=25.8 required.
REGISTRY_IMAGE_TAG=2
MINIO_IMAGE_TAG=latest
BUSYBOX_IMAGE_TAG=1.37
HTTPD_IMAGE_TAG=2.4
S2_IMAGE=ghcr.io/s2-streamstore/s2:latest@sha256:d6ded5ca7dd619fa7c946f06e39a98f9c95c6883c8bb884e5eaa129f232c920c

# -----------------------------------------------------------------------------
# Tuning (defaults shown, all optional)
# -----------------------------------------------------------------------------
POSTGRES_DB=main
DEPLOY_REGISTRY_NAMESPACE=trigger
DOCKER_AUTOREMOVE_EXITED_CONTAINERS=1
# Set 0 to keep exited runner containers around for debugging.
SUPERVISOR_DEBUG=0
# 1 leaks run env vars into supervisor logs (trigger.dev#3566).
RUN_REPLICATION_ENABLED=1
EVENT_REPOSITORY_DEFAULT_STORE=clickhouse_v2
# Empty = keep task events in Postgres instead of ClickHouse.
TRIGGER_TELEMETRY_DISABLED=
# Any non-empty value disables telemetry.
NODE_MAX_OLD_SPACE_SIZE=
# Node heap size in MB, ~80% of container RAM. App default is 8192.
APP_LOG_LEVEL=info
CLICKHOUSE_LOG_LEVEL=info
RUN_REPLICATION_LOG_LEVEL=info
INTERNAL_OTEL_TRACE_LOGGING_ENABLED=0
DEFAULT_ENV_EXECUTION_CONCURRENCY_LIMIT=
DEFAULT_ORG_EXECUTION_CONCURRENCY_LIMIT=

# Realtime streams (s2)
REALTIME_STREAMS_DEFAULT_VERSION=v2
REALTIME_STREAMS_S2_BASIN=trigger-realtime
# Must be >= 8 characters.
REALTIME_STREAMS_S2_ENDPOINT=http://s2/v1
REALTIME_STREAMS_S2_SKIP_ACCESS_TOKENS=true

# -----------------------------------------------------------------------------
# Coolify-generated magic variables (reference only — do not set values here)
# Coolify creates all of these automatically on the first UI deploy.
# -----------------------------------------------------------------------------
# SERVICE_URL_TRIGGER_3000
# Bare on the trigger service -> Traefik loadbalancer port 3000. Coolify also
# auto-creates the portless SERVICE_URL_TRIGGER, which is what's actually used
# for public origins — using the ported form breaks login (coolify#8638).
# SERVICE_FQDN_DOCKERREGISTRY_5000
# Bare on the dockerregistry service -> registry domain, Traefik port 5000.
# The portless SERVICE_FQDN_DOCKERREGISTRY feeds DEPLOY_REGISTRY_HOST and the supervisor.
# SERVICE_USER_POSTGRES
# SERVICE_PASSWORD_POSTGRES
# SERVICE_PASSWORD_64_SESSION
# SERVICE_PASSWORD_64_MAGICLINK
# SERVICE_PASSWORD_ENCRYPTIONKEY
# Exactly 32 chars — Trigger.dev requires exactly 32. Do not replace with
# SERVICE_HEX_32, which is 64 chars on older Coolify.
# SERVICE_PASSWORD_64_PROVIDER
# SERVICE_PASSWORD_64_COORDINATOR
# SERVICE_PASSWORD_64_WORKERSECRET
# SERVICE_USER_CLICKHOUSE
# SERVICE_PASSWORD_64_CLICKHOUSE
# SERVICE_USER_MINIO
# SERVICE_PASSWORD_MINIO
# SERVICE_USER_DOCKERREGISTRY
# SERVICE_PASSWORD_DOCKERREGISTRY
# Registry login credentials — needed for `docker login <registry domain>`
# before `npx trigger.dev deploy`.
# SERVICE_PASSWORD_REGISTRYHTTPSECRET

# -----------------------------------------------------------------------------
# Local syntax check only (Coolify-only stack — a full local boot is not supported)
# -----------------------------------------------------------------------------
# env SERVICE_URL_TRIGGER=https://trigger.example.com SERVICE_URL_TRIGGER_3000=https://trigger.example.com:3000 \
#     SERVICE_FQDN_DOCKERREGISTRY=registry.example.com SERVICE_FQDN_DOCKERREGISTRY_5000=registry.example.com:5000 \
#     SERVICE_USER_POSTGRES=p SERVICE_PASSWORD_POSTGRES=x SERVICE_PASSWORD_64_SESSION=x \
#     SERVICE_PASSWORD_64_MAGICLINK=x SERVICE_PASSWORD_ENCRYPTIONKEY=x SERVICE_PASSWORD_64_PROVIDER=x \
#     SERVICE_PASSWORD_64_COORDINATOR=x SERVICE_PASSWORD_64_WORKERSECRET=x SERVICE_USER_CLICKHOUSE=c \
#     SERVICE_PASSWORD_64_CLICKHOUSE=x SERVICE_USER_MINIO=m SERVICE_PASSWORD_MINIO=x \
#     SERVICE_USER_DOCKERREGISTRY=r SERVICE_PASSWORD_DOCKERREGISTRY=x SERVICE_PASSWORD_REGISTRYHTTPSECRET=x \
#   sh -c 'sed "/exclude_from_hc/d" docker-compose.yaml | docker compose -f - config >/dev/null' && echo OK
