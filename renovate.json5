// This is the ONLY Renovate config for this repo. Renovate resolves `renovate.json5`
// at the root before `.github/renovate.json5`, so a second copy under .github/ is
// never read. Do not reintroduce it.
//
// Upstream compose/config changes that a tag bump cannot carry are tracked by
// .github/workflows/upstream-drift.yml (a sticky issue), not here.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>dodi-smart/.github"],
  // Single-branch repo: Coolify deploys from main, so PRs target main, not the
  // preset's develop.
  baseBranchPatterns: ["main"],
  // best-practices pins Docker and Actions digests via presets that a later
  // `pinDigests: false` packageRule does not override; drop them at the source so
  // image tags and Actions stay readable in review.
  ignorePresets: ["docker:pinDigests", "helpers:pinGitHubActionDigests"],
  customManagers: [
    {
      // `image: name:${VAR:-default}`: the default is the pinned version.
      customType: "regex",
      description: "Image tag defaults in docker-compose.yaml",
      managerFilePatterns: ["/(^|/)docker-compose\\.ya?ml$/"],
      matchStrings: [
        "image:\\s*(?<depName>[^\\s:$]+):\\$\\{\\w+:-(?<currentValue>[^}@\\s]+)\\}",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Annotated image tags in .env.example",
      managerFilePatterns: ["/(^|/)\\.env\\.example$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n[A-Z0-9_]+=(?<currentValue>\\S+)",
      ],
    },
  ],
  packageRules: [
    // The sticky PR: webapp and supervisor must always ship the same tag.
    {
      matchPackageNames: ["ghcr.io/triggerdotdev/trigger.dev", "ghcr.io/triggerdotdev/supervisor"],
      groupName: "trigger.dev",
      // Skip helm-*, latest, main and other non-release tags.
      allowedVersions: "/^v\\d+\\.\\d+\\.\\d+$/",
      addLabels: ["agent:review"],
    },
    // These track the versions upstream hosting/docker pins (on-disk formats or
    // protocol compatibility). Opened only on demand from the Dependency Dashboard.
    {
      matchPackageNames: [
        "postgres",
        "redis",
        "clickhouse/clickhouse-server",
        "registry",
        "ghcr.io/s2-streamstore/s2",
        // s2 runs a copy of /bin/busybox in a distroless image, so it must stay static.
        "busybox",
      ],
      dependencyDashboardApproval: true,
    },
    // Major upgrades need a data migration, not a tag bump.
    { matchPackageNames: ["postgres", "redis"], matchUpdateTypes: ["major"], enabled: false },
    // Tracks `latest` by design (bitnamilegacy is frozen).
    { matchPackageNames: ["bitnamilegacy/minio"], enabled: false },
  ],
}
